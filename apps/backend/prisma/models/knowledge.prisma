enum NoteVisibility {
  PRIVATE
  PROJECT
}

enum SnippetVisibility {
  PRIVATE
  PUBLIC
}

enum ModerationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

model Note {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String         @map("author_id")
  author      User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  projectId   String?        @map("project_id")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  body        String
  color       String?
  isPinned    Boolean        @default(false) @map("is_pinned")
  visibility  NoteVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, authorId])
  @@index([projectId, visibility])
  @@map("note")
}

model Snippet {
  id               String            @id @default(uuid())
  workspaceId      String            @map("workspace_id")
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String?           @map("project_id")
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId         String            @map("author_id")
  author           User              @relation("SnippetAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  name             String
  folder           String
  language         String
  code             String
  visibility       SnippetVisibility @default(PRIVATE)
  moderationStatus ModerationStatus  @default(NOT_REQUESTED) @map("moderation_status")
  reviewedById     String?           @map("reviewed_by_id")
  reviewedBy       User?             @relation("SnippetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?         @map("reviewed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([workspaceId, visibility])
  @@index([workspaceId, folder])
  @@map("snippet")
}

enum KnowledgeScope {
  PRIVATE
  PROJECT
  WORKSPACE
}

model Document {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?        @map("project_id")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId    String         @map("author_id")
  author      User           @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  folder      String
  scope       KnowledgeScope @default(PRIVATE)
  fileName    String         @map("file_name")
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  storageKey  String         @unique @map("storage_key")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, scope])
  @@index([workspaceId, folder])
  @@map("document")
}

model Bookmark {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?        @map("project_id")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId    String         @map("author_id")
  author      User           @relation("BookmarkAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  folder      String
  url         String
  scope       KnowledgeScope @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, scope])
  @@index([workspaceId, folder])
  @@map("bookmark")
}
