enum RoadmapStageStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model Roadmap {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdById String         @map("created_by_id")
  createdBy   User           @relation("RoadmapAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  stages      RoadmapStage[]

  @@index([projectId])
  @@map("roadmap")
}

model RoadmapStage {
  id          String             @id @default(uuid())
  roadmapId   String             @map("roadmap_id")
  roadmap     Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title       String
  description String?
  goal        String?
  points      Int                @default(1)
  status      RoadmapStageStatus @default(PLANNED)
  position    Int
  dueDate     DateTime?          @map("due_date")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([roadmapId, position])
  @@map("roadmap_stage")
}
