enum EventVisibility {
  PRIVATE
  PROJECT
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Event {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String          @map("author_id")
  author      User            @relation("EventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  projectId   String?         @map("project_id")
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  allDay      Boolean         @default(false) @map("all_day")
  visibility  EventVisibility @default(PRIVATE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  participants EventParticipant[]

  @@index([workspaceId, startsAt])
  @@index([projectId, visibility])
  @@map("event")
}

model EventParticipant {
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_participant")
}

model Habit {
  id              String         @id @default(uuid())
  workspaceId     String         @map("workspace_id")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?        @map("project_id")
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String
  frequency       HabitFrequency @default(DAILY)
  targetPerPeriod Int            @default(1) @map("target_per_period")
  color           String?
  archivedAt      DateTime?      @map("archived_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  logs            HabitLog[]

  @@index([workspaceId, userId])
  @@map("habit")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Int      @default(1)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([habitId, date])
  @@index([habitId, date])
  @@map("habit_log")
}
