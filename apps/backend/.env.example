PORT=3000
DATABASE_URL=postgresql://fluxo:fluxo@localhost:5433/fluxo
DB_CONNECT_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-with-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
NODE_ENV=development
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=troque-pelo-usuario-do-mailtrap
SMTP_PASSWORD=troque-pela-senha-do-mailtrap
SMTP_FROM=Fluxo <nao-responda@fluxo.app>
VAULT_STORAGE_DIR=C:/fluxo-storage

# Chave local de 32 bytes em hexadecimal para proteger as chaves do Gemini.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NAMI_ENCRYPTION_KEY=
