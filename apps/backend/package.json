    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
